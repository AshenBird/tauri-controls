{
  "name": "@tauri-controls/vue",
  "version": "0.4.0",
  "private": false,
  "description": "🚥 Native-looking window controls for Tauri 2.",
  "homepage": "https://github.com/agmmnn/tauri-controls#readme",
  "bugs": {
    "url": "https://github.com/agmmnn/tauri-controls/issues"
  },
  "license": "MIT",
  "author": "agmmnn",
  "repository": {
    "type": "git",
    "url": "https://github.com/agmmnn/tauri-controls"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "module": "./dist/tauri-controls.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tauri-controls.js",
      "types": "./dist/index.d.ts"
    },
    "./dev": {
      "import": "./src/tauri-controls/index.ts",
      "types": "./src/tauri-controls/index.ts",
      "style": "./src/tauri-controls/index.css"
    },
    "./style": "./src/tauri-controls/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "format": "prettier --write . --config ./prettier.config.cjs"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "2.10.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.4",
    "vite-plugin-dts": "^3.7.3",
    "vue-tsc": "^2.0.7"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "tailwind-merge": "^1.14.0",
    "vue": "^3.3.4"
  }
}
